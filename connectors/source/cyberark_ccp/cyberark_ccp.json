{
    "appid": "e26b6490-fa73-4cf6-a0df-9f308bf243be",
    "name": "CyberArk CCP",
    "description": "Retrieve credentials from CyberArk Central Credential Provider (CCP) vault",
    "type": "information",
    "product_vendor": "CyberArk",
    "product_name": "Central Credential Provider",
    "product_version_regex": ".*",
    "logo": "logo.svg",
    "logo_dark": "logo_dark.svg",
    "publisher": "Ted",
    "license": "Copyright (c) 2026",
    "app_version": "1.0.29",
    "utctime_updated": "2026-04-13T00:00:00.000000Z",
    "package_name": "phantom_cyberark_ccp",
    "main_module": "cyberark_ccp_connector.py",
    "min_phantom_version": "6.4.1",
    "app_wizard_version": "1.0.0",
    "python_version": "3.13",
    "pip_dependencies": {
        "wheel": []
    },
    "configuration": {
        "base_url": {
            "description": "CyberArk CCP base URL (e.g. https://ccp.example.com)",
            "data_type": "string",
            "required": true,
            "order": 0
        },
        "app_id": {
            "description": "CyberArk Application ID for authentication",
            "data_type": "string",
            "required": true,
            "order": 1
        },
        "timeout": {
            "description": "Request timeout in seconds (default: 60)",
            "data_type": "numeric",
            "required": false,
            "default": 60,
            "order": 2
        },
        "verify_ssl": {
            "description": "Verify server SSL certificate",
            "data_type": "boolean",
            "required": false,
            "default": true,
            "order": 3
        },
        "ph_mtls": {
            "data_type": "ph",
            "order": 4
        },
        "client_cert": {
            "description": "Client certificate PEM string for mTLS",
            "data_type": "string",
            "required": true,
            "order": 5
        },
        "client_key": {
            "description": "Client private key PEM string for mTLS",
            "data_type": "password",
            "required": true,
            "order": 6
        },
        "client_ca": {
            "description": "Custom CA certificate PEM string (optional)",
            "data_type": "string",
            "required": false,
            "order": 7
        },
        "ph_test": {
            "data_type": "ph",
            "order": 8
        },
        "test_safe": {
            "description": "Safe name to use for connectivity testing",
            "data_type": "string",
            "required": true,
            "order": 9
        },
        "test_username": {
            "description": "Username to use for connectivity testing",
            "data_type": "string",
            "required": true,
            "order": 10
        }
    },
    "actions": [
        {
            "action": "test connectivity",
            "identifier": "test_connectivity",
            "description": "Validate the asset configuration for connectivity using supplied configuration",
            "type": "test",
            "read_only": true,
            "parameters": {},
            "output": [],
            "versions": "EQ(*)"
        },
        {
            "action": "get secret",
            "identifier": "get_secret",
            "description": "Retrieve a credential from CyberArk CCP vault",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "safe": {
                    "description": "CyberArk Safe name containing the credential",
                    "data_type": "string",
                    "required": true,
                    "order": 0,
                    "contains": [
                        "cyberark safe"
                    ]
                },
                "username": {
                    "description": "Username of the account to retrieve",
                    "data_type": "string",
                    "required": true,
                    "order": 1,
                    "contains": [
                        "user name"
                    ]
                },
                "object": {
                    "description": "Object name for disambiguation (optional)",
                    "data_type": "string",
                    "required": false,
                    "order": 2
                },
                "address": {
                    "description": "Filter by address (optional, for disambiguation)",
                    "data_type": "string",
                    "required": false,
                    "order": 3,
                    "contains": [
                        "host name"
                    ]
                }
            },
            "output": [
                {
                    "data_path": "action_result.parameter.safe",
                    "data_type": "string",
                    "contains": [
                        "cyberark safe"
                    ]
                },
                {
                    "data_path": "action_result.parameter.username",
                    "data_type": "string",
                    "contains": [
                        "user name"
                    ]
                },
                {
                    "data_path": "action_result.parameter.object",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.parameter.address",
                    "data_type": "string",
                    "contains": [
                        "host name"
                    ]
                },
                {
                    "data_path": "action_result.data.*.password",
                    "data_type": "string",
                    "contains": [
                        "password"
                    ]
                },
                {
                    "data_path": "action_result.data.*.username",
                    "data_type": "string",
                    "contains": [
                        "user name"
                    ]
                },
                {
                    "data_path": "action_result.data.*.address",
                    "data_type": "string",
                    "contains": [
                        "host name"
                    ]
                },
                {
                    "data_path": "action_result.data.*.safe",
                    "data_type": "string",
                    "contains": [
                        "cyberark safe"
                    ]
                },
                {
                    "data_path": "action_result.data.*.object",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.password_change_in_process",
                    "data_type": "boolean"
                },
                {
                    "data_path": "action_result.status",
                    "data_type": "string",
                    "example_values": [
                        "success",
                        "failed"
                    ]
                },
                {
                    "data_path": "action_result.message",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.summary.credentials_found",
                    "data_type": "numeric"
                },
                {
                    "data_path": "summary.total_objects",
                    "data_type": "numeric"
                },
                {
                    "data_path": "summary.total_objects_successful",
                    "data_type": "numeric"
                }
            ],
            "render": {
                "type": "table"
            },
            "versions": "EQ(*)"
        }
    ]
}
